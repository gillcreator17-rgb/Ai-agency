rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'dilkarngill6@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Validation helper for ServiceInquiry
    function isValidServiceInquiry(data) {
      return data.keys().hasAll(['id', 'userId', 'serviceType', 'projectTitle', 'description', 'status']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.serviceType is string && data.serviceType.size() <= 64 &&
        data.projectTitle is string && data.projectTitle.size() > 0 && data.projectTitle.size() <= 150 &&
        data.description is string && data.description.size() <= 3000 &&
        data.status is string && data.status in ['submitted', 'reviewing', 'in_progress', 'completed', 'cancelled'] &&
        (!('budgetRange' in data) || (data.budgetRange is string && data.budgetRange.size() <= 64)) &&
        (!('timeline' in data) || (data.timeline is string && data.timeline.size() <= 64)) &&
        (!('aiProposal' in data) || (data.aiProposal is string && data.aiProposal.size() <= 5000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Validation helper for SavedModel
    function isValidSavedModel(data) {
      return data.keys().hasAll(['id', 'userId', 'modelId', 'modelName']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.modelId is string && data.modelId.size() <= 64 &&
        data.modelName is string && data.modelName.size() <= 120 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('priceMonthly' in data) || (data.priceMonthly is number)) &&
        (!('savedAt' in data) || (data.savedAt is string && data.savedAt.size() <= 64));
    }

    // Validation helper for ChatTranscript
    function isValidChatTranscript(data) {
      return data.keys().hasAll(['id', 'userId', 'modelName', 'title', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.modelName is string && data.modelName.size() <= 100 &&
        data.title is string && data.title.size() <= 150 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('messageCount' in data) || (data.messageCount is number)) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000));
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Admin role collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Profile Document & Subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidUserProfile(request.resource.data) &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) || isAdmin();

      // Service Inquiries Subcollection
      match /inquiries/{inquiryId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(inquiryId) &&
          isValidServiceInquiry(request.resource.data) &&
          request.resource.data.userId == userId;
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(inquiryId) &&
          isValidServiceInquiry(request.resource.data) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Saved Models Subcollection
      match /savedModels/{savedModelId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(savedModelId) &&
          isValidSavedModel(request.resource.data) &&
          request.resource.data.userId == userId;
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(savedModelId) &&
          isValidSavedModel(request.resource.data) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Chat Transcripts Subcollection
      match /chatHistory/{chatId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(chatId) &&
          isValidChatTranscript(request.resource.data) &&
          request.resource.data.userId == userId;
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(chatId) &&
          isValidChatTranscript(request.resource.data) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
